// SLURM execution profile for the Narval (Digital Research Alliance of Canada /
// Compute Canada) cluster, in the style of ngstk's slurm_tools submission
// pattern: one sbatch job runs the Nextflow head process, which in turn
// submits one SLURM job per pipeline task via Nextflow's own slurm executor.
//
// Deliberately says nothing about containers: ngstk itself runs on Narval
// without any (vcfanno as a static binary + htslib/tabix via module load +
// a plain venv for the Python report step, all just on $PATH -- see
// slurm/submit_wholeexome.sh), and Narval compute nodes generally can't
// reach the internet to pull images on demand. If you'd rather use
// Apptainer/Singularity with pre-cached images, add -profile singularity
// alongside this one and set NXF_SINGULARITY_CACHEDIR; don't rely on
// REPORT_VARIANTS' `conda` directive on its own here -- Compute Canada
// discourages conda, use the venv route in slurm/submit_wholeexome.sh instead.
//
// Usage: nextflow run main.nf -profile narval_slurm --slurm_account rrg-jbriv ...
// (or submit via slurm/submit_wholeexome.sh, which wraps this profile in its
// own sbatch job for the Nextflow head process itself)

process {
    executor       = 'slurm'
    clusterOptions = { "--account=${params.slurm_account}" }
    scratch        = '$SLURM_TMPDIR'
}

executor {
    name         = 'slurm'
    queueSize    = 50
    pollInterval = '30 sec'
}
