manifest {
    name            = 'nextflow-wholeexome'
    description     = 'Whole-exome variant annotation and reporting, run downstream of nf-core/sarek, incorporating RI-MUHC-Bioinformatics/ngstk exome resources'
    author          = 'mikal16'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.04.0'
    version         = '0.1.0'
}

params {
    // --- required inputs ---
    input               = null   // glob to sarek germline VCFs, e.g. 'results/sarek/variant_calling/haplotypecaller/*/*.filtered.vcf.gz'
    genome              = 'GRCh38'
    exome_target_set    = 'default'   // GRCh38: 'default' only. GRCh37: 'default' | 'ucsc_all_exons' | 'ucsc_coding'

    // --- ngstk resource roots (must contain gnomad/clinvar/cosmic/dbsnp/cadd/revel/dbscsnv/segdup/hgnc/hpo, see docs/usage.md) ---
    resources_dir       = null   // exported as $RESOURCES, consumed by conf/*.ini and assets/vcfanno_*.toml
    bin_dir              = null   // exported as $BIN, reserved for future ngstk-derived steps that reference $BIN

    // --- reporting ---
    reporting_file       = null   // optional ngstk-style CSV grouping samples into reports (see ngstk dnaseq_exome README); default: one combined report
    variant_caller        = 'GATK'
    annotation_tool        = 'snpeff'   // reportVariants.py currently only implements the 'snpeff' ANN-field parser

    // --- vendored ngstk config/resource files (do not usually need to be overridden) ---
    grch38_config                    = "${projectDir}/conf/dnaseq_exome_grch38_config.ini"
    grch37_config                    = "${projectDir}/conf/dnaseq_exome_grch37_config.ini"
    grch37_config_ucsc_all_exons     = "${projectDir}/conf/dnaseq_exome_grch37_config_ucsc_all_exons.ini"
    grch37_config_ucsc_coding        = "${projectDir}/conf/dnaseq_exome_grch37_config_ucsc_coding.ini"
    vcfanno_toml_grch38               = "${projectDir}/assets/vcfanno_grch38.toml"
    vcfanno_toml_grch37               = "${projectDir}/assets/vcfanno_grch37.toml"

    outdir                = 'results'
    slurm_account          = null   // Narval RAP ID, e.g. 'rrg-jbriv', required by -profile narval_slurm
}

profiles {
    standard {
        process.executor = 'local'
    }
    narval_slurm {
        includeConfig 'conf/narval_slurm.config'
    }
    docker {
        docker.enabled       = true
        singularity.enabled  = false
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        docker.enabled           = false
    }
    conda {
        conda.enabled = true
    }
}

includeConfig 'conf/base.config'

def genomeInUse = params.genome
includeConfig genomeInUse == 'GRCh37' ? 'conf/grch37.config' : 'conf/grch38.config'

env {
    RESOURCES = params.resources_dir
    BIN       = params.bin_dir
}

dag {
    enabled  = true
    file     = "${params.outdir}/pipeline_info/pipeline_dag.html"
}
report {
    enabled  = true
    file     = "${params.outdir}/pipeline_info/execution_report.html"
}
trace {
    enabled  = true
    file     = "${params.outdir}/pipeline_info/execution_trace.txt"
}
