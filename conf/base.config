// Per-process resources.
// VCFANNO / REPORT_VARIANTS figures are carried over as-is from
// RI-MUHC-Bioinformatics/ngstk's slurm_tools/dnaseq_exome_slurm_config.ini
// ([VCFANNO] and [REPORT_VARIANTS] sections), which were tuned against real
// exome batches on Narval. BGZIP_TABIX has no ngstk equivalent (ngstk calls
// vcfanno's own bgzip/tabix piping inline) so it gets a conservative default.

process {

    cpus   = 1
    memory = { 4.GB * task.attempt }
    time   = { 2.h * task.attempt }

    errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : 'finish' }
    maxRetries    = 2

    withName: 'VCFANNO' {
        cpus   = 6
        memory = { 3.GB * task.attempt }   // 500M per-cpu x 6 cpus, per ngstk ini
        time   = { 6.h * task.attempt }
    }

    withName: 'BGZIP_TABIX' {
        cpus   = 2
        memory = 2.GB
        time   = 1.h
    }

    withName: 'REPORT_VARIANTS' {
        cpus   = 1
        memory = { 10.GB * task.attempt }
        time   = { 3.h * task.attempt }
    }
}
