// SLURM execution profile for the Narval (Digital Research Alliance of Canada /
// Compute Canada) cluster, in the style of ngstk's slurm_tools submission
// pattern: one sbatch job runs the Nextflow head process, which in turn
// submits one SLURM job per pipeline task via Nextflow's own slurm executor.
//
// Usage: nextflow run main.nf -profile narval_slurm --slurm_account rrg-jbriv ...
// (or submit via slurm/submit_wholeexome.sh, which wraps this profile in its
// own sbatch job for the Nextflow head process itself)

process {
    executor       = 'slurm'
    clusterOptions = { "--account=${params.slurm_account}" }
    scratch        = '$SLURM_TMPDIR'
}

executor {
    name      = 'slurm'
    queueSize = 50
    pollInterval = '30 sec'
}

singularity {
    enabled    = true
    autoMounts = true
}
