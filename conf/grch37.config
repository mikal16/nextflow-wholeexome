// GRCh37-specific defaults. ngstk ships three exome target-region variants
// for GRCh37 (--exome_target_set): 'default', 'ucsc_all_exons', 'ucsc_coding'.
// See conf/dnaseq_exome_grch37_config*.ini for what each one points at.

params {
    exome_target_set = params.exome_target_set ?: 'default'
}
